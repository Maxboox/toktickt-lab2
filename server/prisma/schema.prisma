// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modèle Requester (utilisateur qui crée des tickets)
model Requester {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  tickets     Ticket[]
  
  @@map("requesters")
}

// Modèle Category (catégorie du ticket)
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  tickets     Ticket[]
  
  @@map("categories")
}

// Modèle System (système concerné par le ticket)
model System {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  tickets     Ticket[]
  
  @@map("systems")
}

// Modèle Ticket (le ticket de support)
model Ticket {
  id              Int       @id @default(autoincrement())
  ticketNumber    String    @unique
  ticketDate      DateTime  @default(now())
  
  // Relations
  requesterId     Int
  requester       Requester @relation(fields: [requesterId], references: [id])
  
  categoryId      Int
  category        Category  @relation(fields: [categoryId], references: [id])
  
  systemId        Int
  system          System    @relation(fields: [systemId], references: [id])
  
  // Champs du ticket
  summary         String
  requestedPriority RequestedPriority @default(MEDIUM)
  itPriority      ITPriority?
  currentStatus   TicketStatus @default(NEW)
  description     String
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  attachments     Attachment[]
  
  @@index([requesterId])
  @@index([currentStatus])
  @@index([ticketNumber])
  @@map("tickets")
}

// Modèle Attachment (pièce jointe d'un ticket)
model Attachment {
  id              Int       @id @default(autoincrement())
  ticketId        Int
  ticket          Ticket    @relation(fields: [ticketId], references: [id])
  
  requesterId     Int
  requester       Requester @relation(fields: [requesterId], references: [id])
  
  fileName        String
  fileType        String
  fileSize        Int
  filePath        String
  uploadDate      DateTime  @default(now())
  
  // Soft delete
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletionReason  String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([ticketId])
  @@index([isDeleted])
  @@map("attachments")
}

// Enums
enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ITPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}
